# Copy to .env and change the passwords. .env is gitignored.

# --- Postgres superuser / migration owner (used by docker-compose and Alembic) ---
POSTGRES_USER=scoutbase
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=scoutbase
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- LOGIN users created by migration 0003 ---
SCOUTBASE_PIPELINE_PASSWORD=change-me-pipeline
SCOUTBASE_APP_PASSWORD=change-me-app
SCOUTBASE_READONLY_PASSWORD=change-me-readonly
